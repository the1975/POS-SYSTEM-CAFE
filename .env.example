# Backend
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/monster_cafe
CORS_ORIGINS=http://localhost:5173
# Reservasi stok (menit) - nilai kerja sementara, bisa diubah tanpa ubah kode
RESERVATION_TIMEOUT_MINUTES=7
# Order READY yang tidak diambil lebih lama dari ini (menit) menjadi OVERDUE
PICKUP_OVERDUE_MINUTES=30

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Seed admin awal (isi nilai asli HANYA di .env, bukan di sini)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Rahasia token tracking order (wajib di production; isi acak panjang)
TRACKING_TOKEN_SECRET=
TAX_RATE_PERCENT=10
MAX_QUANTITY_PER_ITEM=20

# Rahasia token tracking order (wajib di production; isi acak panjang)

# Rahasia token login staff (wajib di production; isi acak panjang)
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60

# Rahasia tanda tangan webhook payment provider (wajib di production)
PAYMENT_WEBHOOK_SECRET=
